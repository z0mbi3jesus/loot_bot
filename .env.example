# ── Discord ────────────────────────────────────────────────────────────────
# Your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your-bot-token-here

# The ID of your Discord server (right-click server icon → Copy Server ID)
GUILD_ID=123456789012345678

# ── Google Sheets ──────────────────────────────────────────────────────────
# Path to the service account JSON file downloaded from Google Cloud Console
GSPREAD_SERVICE_ACCOUNT_FILE=service_account.json

# The ID from your spreadsheet URL:
# https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
SPREADSHEET_ID=your-spreadsheet-id-here

# ── Bot Settings ───────────────────────────────────────────────────────────
# Storage backend. Keep google_sheets for now, or set postgres later.
# SQLite is deprecated and no longer supported by the current bot.
DATA_BACKEND=postgres

# PostgreSQL settings (use DATABASE_URL or the individual PG* values).
DATABASE_URL=postgresql://user:password@localhost:5432/loot_bot
PGHOST=localhost
PGPORT=5432
PGDATABASE=loot_bot
PGUSER=loot_bot_user
PGPASSWORD=secret

# Discord role name that can run officer commands (start/end session, raffle loot, add tickets)
OFFICER_ROLE=Officer

# Optional channel ID where the bot will post normal command responses.
# If unset, the bot uses the same channel where the command was issued.
BOT_CHANNEL_ID=

# Voice channels to watch for the 30-minute ticket ticker.
# Set these via /add_watch_channel in Discord after the bot starts.
